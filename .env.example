VITE_GROQ_API_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Leave blank to use https://<VITE_FIREBASE_PROJECT_ID>-default-rtdb.firebaseio.com
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── Cloudflare Workers AI image generation ───────────────────────────────────
#
# VERCEL (production):
#   Set CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN in
#   Vercel → Project → Settings → Environment Variables (Production scope).
#   The /api/cf-image serverless function reads these from process.env.
#   The token needs the "Workers AI" Read/Edit permission on api.cloudflare.com.
#
#   CLOUDFLARE_ACCOUNT_ID=<your cloudflare account id>
#   CLOUDFLARE_API_TOKEN=<your cloudflare api token with Workers AI permission>
#
# LOCAL DEV (Vite dev-server proxy):
#   The Vite dev-server proxy at /api/cf-image uses VITE_* values from this
#   file (they are NOT exposed to the browser bundle in production).
VITE_CF_ACCOUNT_ID=
VITE_CF_AI_TOKEN=

# Optional: override the proxy path (defaults to /api/cf-image)
# VITE_CF_AI_PROXY_URL=/api/cf-image

# Optional: override the primary/fallback Workers AI image models
# VITE_CF_AI_MODEL=@cf/black-forest-labs/flux-1-schnell
# VITE_CF_AI_FALLBACK_MODEL=@cf/black-forest-labs/flux-2-klein-9b

# Optional: override the default text model (vision requests always use qwen/qwen3.8-27b)
# VITE_AI_MODEL=openai/gpt-oss-120b
