VITE_GROQ_API_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Leave blank to use https://<VITE_FIREBASE_PROJECT_ID>-default-rtdb.firebaseio.com
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudflare Workers AI image generation.
# Preferred: deploy netlify/functions/cf-image.mjs and set CF_ACCOUNT_ID /
# CF_AI_TOKEN as Netlify function environment variables (Functions scope).
# The VITE_* values below are only used by the Vite dev-server proxy
# (Vite inlines VITE_* values into the client bundle).
VITE_CF_ACCOUNT_ID=
VITE_CF_AI_TOKEN=
# Optional: same-origin proxy path, or a full URL to a hosted image proxy.
# VITE_CF_AI_PROXY_URL=/api/cf-image
# Optional: override the primary/fallback Workers AI image models
# VITE_CF_AI_MODEL=@cf/black-forest-labs/flux-1-schnell
# VITE_CF_AI_FALLBACK_MODEL=@cf/black-forest-labs/flux-2-klein-9b

# Optional: override the default text model (vision requests always use qwen/qwen3.8-27b)
# VITE_AI_MODEL=openai/gpt-oss-120b
